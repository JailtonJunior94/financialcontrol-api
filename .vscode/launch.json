{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Development (API)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/financialcontrol-api/main.go",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PORT": "4000",
                "ENVIRONMENT": "Development"
            },
            "args": []
        },
