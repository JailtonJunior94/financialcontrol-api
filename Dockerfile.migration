# syntax=docker/dockerfile:1.7
ARG GO_VERSION=1.26
FROM golang:${GO_VERSION}-alpine AS build
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0
RUN go build -trimpath \
    -ldflags="-s -w \
      -X 'github.com/jailtonjunior94/financialcontrol-api/internal/bootstrap/migration.Version=${VERSION}' \
      -X 'github.com/jailtonjunior94/financialcontrol-api/internal/bootstrap/migration.Commit=${COMMIT}' \
      -X 'github.com/jailtonjunior94/financialcontrol-api/internal/bootstrap/migration.BuildDate=${BUILD_DATE}'" \
    -o /out/migration ./cmd/migration
FROM gcr.io/distroless/static-debian12:nonroot
USER nonroot:nonroot
COPY --from=build /out/migration /migration
ENTRYPOINT ["/migration"]
