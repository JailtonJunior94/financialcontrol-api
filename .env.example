ENVIRONMENT=development
SERVICE_NAME=financialcontrol-api
# SERVICE_VERSION is set automatically from the binary's -ldflags at startup (default: dev).
# Override here only to pin a specific version string in local testing.
# SERVICE_VERSION=dev

# MSSQL connection string. Must start with sqlserver://.
# For local/dev: plain connection without TLS is acceptable.
# For staging/prod: add &encrypt=true&trustServerCertificate=false for TLS (recommended, D-58).
MSSQL_CONNECTION_STRING=sqlserver://sa:YourPassword@localhost:1433?database=FinancialControlDB

JWT_SECRET=YourBase64EncodedSecret

# OTel export settings.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc   # grpc | http/protobuf
# LOG_LEVEL=info                      # debug | info | warn | error
# SLOW_QUERY_THRESHOLD_MS=1000

# K8s downward API resource attributes.
# These are injected automatically in K8s via the downward API (see financialapi-dp.yaml).
# Leave empty for local development; the app falls back to "unknown" and logs a WARN.
# POD_UID=
# POD_NAME=
# POD_NAMESPACE=
# CONTAINER_NAME=

# Migration CLI settings (cmd/migration). See cmd/migration/README.md for full reference.
# MIGRATION_TIMEOUT=10m          # global timeout for migration run (default: 10m)
# MIGRATION_BASELINE=1           # set once for pre-existing environments; must be >= 1
